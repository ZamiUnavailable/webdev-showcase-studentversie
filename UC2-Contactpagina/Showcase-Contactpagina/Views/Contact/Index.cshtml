@model Contactform
@{
    ViewData["Title"] = "Contactpagina";
}
@inject IConfiguration configuration
@{
    var siteKey = configuration["reCaptchaSettings:SiteKey"];
}

<script src="https://www.google.com/recaptcha/api.js?onload=onloadCallback&render=explicit"
        async defer>
</script>


<div class="page">
    <section class="person-section-contact">

        <img class="person-logo" src="images/person-pasfoto.png">

        <h1 class="person-name">Zara Klaren</h1>


    </section>


    <section class="contact">
        <h1>Contact</h1>
        <p>@ViewBag.Message</p>
        <div id="flash-message" class="flash-message" style="display: none;"></div>

        <form method="post" class="form-contactpagina">
            @Html.AntiForgeryToken()
            <input type="hidden" id="recaptchaTokenInputId" asp-for="RecaptchaToken" />

            <div class="form-contactpagina__inputelement fx-col">
                <label for="firstname">Voornaam* </label>
                <input type="text" asp-for="FirstName" id="firstname" required>
            </div>

            <div class="form-contactpagina__inputelement fx-col">
                <label for="lastname">Achternaam* </label>
                <input type="text" asp-for="LastName" id="lastname" required>
            </div>

            <div class="form-contactpagina__inputelement fx-col">
                <label for="email">E-mailadres </label>
                <input type="email" asp-for="Email" id="email">
            </div>

            <div class="form-contactpagina__inputelement fx-col">
                <label for="phone">Telefoonnummer* </label>
                <input type="tel" asp-for="Phone" id="phone" required>
            </div>

            <div class="form-contactpagina__inputelement fx-col">
                <label for="subject">Onderwerp </label>
                <input type="text" asp-for="Subject" id="subject">
            </div>

            <div class="form-contactpagina__inputelement fx-col">
                <label for="message">Bericht</label>
                <textarea asp-for="Message" id="message" rows="4"></textarea>
            </div>

            <div id="html_element"></div>
            <hr />

            <div class="form-contactpagina__inputelement">
                <div class="buttons">
                    <input type="reset" class="button-reset" value="Reset">
                    <div id="spinner" class="spinner"></div>

                    <input type="submit" class="button-verstuur" disabled="disabled" value="Verstuur!">
                </div>
            </div>

        </form>

        <p>* verplicht veld</p>

    </section>
</div>

<script>

        let form, inputEmail, inputFirstName, inputLastName, inputPhone, inputSubject, inputMessage, submitButton;


         var onloadCallback = function() {
          // alert("grecaptcha is ready!");
          grecaptcha.render('html_element', {
              'sitekey' : '@siteKey',
              'callback': onCaptchaSuccess
            });
        };
        function onCaptchaSuccess(token) {
            document.getElementById("recaptchaTokenInputId").value = token;
            // document.querySelector('input[type="submit"]').disabled = false;
            //i want the checkFormValidity
            checkFormValidity();

        }


            function validateName(input, showMessage, currentField) {
                const minLength = 2;
                const maxLength = 60;
                const nameValue = input.value.trim();
                let isValid = true;

                if (nameValue.length < minLength) {
                    input.setCustomValidity(`Moet minimaal ${minLength} tekens bevatten.`);
                    isValid = false;
                } else if (nameValue.length > maxLength) {
                    input.setCustomValidity(`Mag niet langer dan ${maxLength} tekens zijn.`);
                    isValid = false;
                } else {
                    input.setCustomValidity("");
                }

                if(currentField){updateFieldStyle(input, isValid);}
                if(showMessage){input.reportValidity();}
                return isValid;
            };


             function validateEmail(showMessage, currentField) {
                    const maxLength = 80;
                    const emailValue = inputEmail.value.trim();
                    let isValid = true;

                    if (inputEmail.validity.typeMismatch) {
                        inputEmail.setCustomValidity("Voer een geldig e-mailadres in!");
                        isValid = false;
                    } else if (emailValue.length > maxLength) {
                        inputEmail.setCustomValidity(`Email mag niet langer dan ${maxLength} tekens zijn!`);
                        isValid = false;
                    } else {
                        inputEmail.setCustomValidity("");
                    }

                    if(currentField){updateFieldStyle(inputEmail, isValid);}
                    if(showMessage){
                inputEmail.reportValidity();
                }
                    return isValid;
                };


            function validatePhone(showMessage, currentField)  {
                const phoneValue = inputPhone.value.trim(); //trim for white spaces in front and end of a message?
                const phonePattern = /^[0-9+\-]{8,20}$/; // alleen cijfers, + en -
                let isValid = phonePattern.test(phoneValue);

                if (!isValid) {
                    inputPhone.setCustomValidity("Voer een geldig telefoonnummer in (8-20 cijfers, alleen + of - toegestaan).");
                } else {
                    inputPhone.setCustomValidity("");
                }

                if(currentField){updateFieldStyle(inputPhone, isValid);}
                if(showMessage){
                    inputPhone.reportValidity();
                }
                return isValid;
            };



            function validateSubject()  {
                const maxLength = 200;
                const subjectValue = inputSubject.value.trim();
                let isValid = true;

               if (subjectValue.length > maxLength) {
                    inputSubject.setCustomValidity(`Onderwerp mag niet langer dan ${maxLength} tekens zijn!`);
                    isValid = false;
                } else {
                    inputSubject.setCustomValidity("");
                }

                updateFieldStyle(inputSubject, isValid);
                inputSubject.reportValidity();
                return isValid;
            };

            function validateMessage () {
                const maxLength = 600;
                const messageValue = inputMessage.value.trim();
                let isValid = true;

                if (messageValue.length > maxLength) {
                    inputMessage.setCustomValidity(`Bericht mag niet langer dan ${maxLength} tekens zijn!`);
                    isValid = false;
                } else {
                    inputMessage.setCustomValidity("");
                }

                updateFieldStyle(inputMessage, isValid);
                inputMessage.reportValidity();
                return isValid;
            };





        function checkFormValidity ()  {
        const isFormValid = validateEmail(true, true) &&
                            validateName(inputFirstName, true, true) &&
                            validateName(inputLastName, true, true) &&
                            validatePhone(true, true) &&
                            validateSubject() &&
                            validateMessage();

        const isCaptchaCompleted = grecaptcha.getResponse().length > 0;

        submitButton.disabled = !(isFormValid && isCaptchaCompleted);
    };

        function checkFormValidity1(){
            const isFormValid = validateEmail(false, false) &&
                                validateName(inputFirstName, false, false) &&
                                validateName(inputLastName, false, false) &&
                                validatePhone(false, false) &&
                                validateSubject() &&
                                validateMessage();

            const isCaptchaCompleted = grecaptcha.getResponse().length > 0;

            submitButton.disabled = !(isFormValid && isCaptchaCompleted);
        };


                  function updateFieldStyle (input, isValid) {
                if (isValid) {
                    input.classList.remove("error");
                } else {
                    input.classList.add("error");
                }
            };

        document.addEventListener("DOMContentLoaded", () => {
            form = document.querySelector('.form-contactpagina');
            inputEmail = document.getElementById('email');
            inputFirstName = document.getElementById('firstname');
             inputLastName = document.getElementById('lastname');
             inputPhone = document.getElementById('phone');
             inputSubject = document.getElementById('subject');
             inputMessage = document.getElementById('message');
             captcha = document.getElementById('recaptchaTokenInputId');
             submitButton = document.querySelector('input[type="submit"]');
             spinner = document.getElementById('spinner');

            // functies om de spinner te tonen en knop te (de)activeren
            const showSpinner = () => {
                spinner.style.display = "inline-block";
                submitButton.disabled = true;
            };
            const hideSpinner = () => {
                spinner.style.display = "none";
                // submitButton.disabled = false;
            };



                      const validateCaptcha = () => {
                let token = grecaptcha.getResponse();
                if (!token) {
                    return false;
                }
                document.getElementById("recaptchaTokenInputId").value = token;
                return true;
            };



            [inputEmail, inputFirstName, inputLastName, inputPhone, inputSubject, inputMessage].forEach(input => {
                input.addEventListener("input", checkFormValidity1);
            });

            [inputEmail, inputFirstName, inputLastName, inputPhone, inputSubject, inputMessage].forEach(input => {
                input.addEventListener("blur", checkFormValidity1);
            });

           // eventlisteners voor validatie
            inputEmail.addEventListener("blur", () => validateEmail(true, true));
            inputEmail.addEventListener("input", () => validateEmail(true, true));

            inputFirstName.addEventListener("blur", () => validateName(inputFirstName, true, true));
            inputFirstName.addEventListener("input", () => validateName(inputFirstName, true, true));

            inputLastName.addEventListener("blur", () => validateName(inputLastName, true, true));
            inputLastName.addEventListener("input", () => validateName(inputLastName, true, true));

            inputPhone.addEventListener("blur", () => validatePhone(true, true));
            inputPhone.addEventListener("input", () => validatePhone(true, true));

            inputSubject.addEventListener("blur", validateSubject);
            inputSubject.addEventListener("input", validateSubject);

            inputMessage.addEventListener("blur", validateMessage);
            inputMessage.addEventListener("input", validateMessage);


            form.addEventListener('submit', function (event) {
                event.preventDefault();
                checkFormValidity();

                if (!form.checkValidity()) {
                    return;
                }
                if (!validateCaptcha()) {

                    const flashMessage = document.getElementById("flash-message");
                        flashMessage.textContent = "Voltooi de Captcha om het formulier te versturen.";
                        flashMessage.style.display = "block";
                        flashMessage.classList.remove("success");
                        flashMessage.classList.add("error");

                        setTimeout(() => {
                            flashMessage.style.display = "none";
                        }, 5000);
                    return;
                }

                showSpinner();
                const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]').value;

                   const formData = new URLSearchParams(new FormData(form));
                    // formData.append('__RequestVerificationToken', csrfToken);


                fetch('/contact', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': csrfToken
                    },
                    body: formData
                })
                    .then(response => {
                        if (!response.ok) {
                            throw new Error(`HTTP-fout! Status: ${response.status}`);
                        }
                        return response.text();
                    })
                    .then(data => {
                        //flash message voor succes
                        const flashMessage = document.getElementById("flash-message");
                        flashMessage.textContent = "Het contactformulier is verstuurd!";
                        flashMessage.style.display = "block";
                        flashMessage.classList.remove("error");
                        flashMessage.classList.add("success");

                        form.reset();
                        document.querySelector('input[type="submit"]').disabled = true;

                        grecaptcha.reset();
                        document.querySelectorAll('.error').forEach(input => {
                            input.classList.remove('error');
                        });

                        setTimeout(() => { //flash message na 5 sec weg
                            flashMessage.style.display = "none";
                        }, 5000);
                    })
                    .catch(error => {
                        console.error('Er was een probleem met de formulierinzending:', error);

                        // message foutmelding
                        const flashMessage = document.getElementById("flash-message");
                        flashMessage.textContent = "Er is iets misgegaan. Probeer het opnieuw.";
                        flashMessage.style.display = "block";
                        flashMessage.classList.remove("success");
                        flashMessage.classList.add("error");
                        submitButton.disabled = false;


                        setTimeout(() => {
                            flashMessage.style.display = "none";
                        }, 5000);
                    })
                    .finally(() => {
                        hideSpinner();
                    });
            });


        });

</script>

